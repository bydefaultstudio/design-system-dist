{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bydefault.design/assets/data/layout-spec.schema.json",
  "title": "Layout Spec",
  "description": "Layout Spec version 4: the rules artwork lives by. A canvas, the specimen it is tested against, and a stack of zones, shapes, guides, grids, measures, notes and images. Every property inside a layer's settings is optional and has a stated default (format-system.md §0, cms/layout-spec.md). Read and written by assets/js/layer-stack.js.",
  "type": "object",
  "required": ["version", "canvas", "layers"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 4, "description": "The format version. Version 1 to 3 specs are converted on the way in (layer-stack.js: convertV1, splitPaint, and a measure read as one width line)." },
    "template": { "type": "string", "maxLength": 64, "description": "The template the spec started from, or empty." },
    "canvas": { "$ref": "#/$defs/canvas" },
    "reference": {
      "description": "The canvas size px lengths were written for. A canvas of the same ratio at another size scales them.",
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "specimen": { "$ref": "#/$defs/specimenSource" },
    "layers": {
      "description": "Bottom to top. Exactly one is the specimen layer, at this top level.",
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/layer" },
          { "$ref": "#/$defs/group" }
        ]
      },
      "contains": { "type": "object", "properties": { "type": { "const": "specimen" } }, "required": ["type"] },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "unit": { "enum": ["px", "%", "X"] },
    "token": { "type": "string", "pattern": "^--[\\w-]{1,64}$" },
    "length": {
      "description": "A length: a number in a unit, or a token read from the brand's theme. px is canvas units, % a share of the reference box, X the specimen's own unit.",
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "unit"],
          "additionalProperties": false,
          "properties": { "value": { "type": "number" }, "unit": { "$ref": "#/$defs/unit" } }
        },
        {
          "type": "object",
          "required": ["token", "unit"],
          "additionalProperties": false,
          "properties": { "token": { "$ref": "#/$defs/token" }, "unit": { "$ref": "#/$defs/unit" }, "value": { "type": "number", "description": "The fallback when the token cannot be read." } }
        }
      ]
    },
    "lineWeight": {
      "description": "A line's weight in screen pixels: the strokes do not scale.",
      "allOf": [
        { "$ref": "#/$defs/length" },
        { "properties": { "unit": { "const": "px" } } }
      ]
    },
    "fraction": {
      "description": "0 to 1, or a token.",
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        {
          "type": "object",
          "required": ["token"],
          "additionalProperties": false,
          "properties": { "token": { "$ref": "#/$defs/token" }, "value": { "type": "number" } }
        }
      ]
    },
    "colour": {
      "description": "Any CSS colour or var() reference, short and plain. Empty means the type's own default.",
      "type": "string",
      "pattern": "^([#\\w\\s(),.%-]{1,64})?$"
    },
    "reference": { "enum": ["canvas", "specimen"] },
    "draw": { "enum": ["outline", "fill", "both"] },
    "lineStyle": { "enum": ["solid", "dashed"] },
    "canvas": {
      "description": "The root of every spec. Not a layer: it cannot move, hide or go.",
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "fit": { "enum": ["fit-artwork", "contain", "cover"], "default": "contain", "description": "fit-artwork: the canvas hugs the specimen. contain: the specimen fits inside. cover: the specimen fills it, cropped at the edge." },
        "shape": { "enum": ["rectangle", "circle", "rounded", "app-icon"], "default": "rectangle", "description": "One outline per canvas. It clips the reference (the specimen, the background, an image under the specimen), never the rules." },
        "radius": { "type": "number", "minimum": 0, "maximum": 50, "default": 22, "description": "A rounded shape's corner, in % of the shorter side." },
        "shapeShow": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["outside", "inside", "outline"] },
          "default": [],
          "description": "outside: shade what the shape cuts away. inside: shade what stays. outline: draw it."
        },
        "background": { "$ref": "#/$defs/colour", "default": "", "description": "A colour or a colour token. Empty is transparent." }
      }
    },
    "specimenSource": {
      "description": "What stands in for the artwork. An image is named only: the picture never enters the spec.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["icon", "logo", "svg"] },
            "key": { "type": "string" },
            "name": { "type": "string" },
            "src": { "type": "string" },
            "unit": { "type": "number", "minimum": 0 },
            "prefer": { "enum": ["square"], "description": "A template's hint to the host choosing the asset: a square one, for an avatar." }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "image" }, "name": { "type": "string", "maxLength": 200 } }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "none" } }
        }
      ]
    },
    "envelope": {
      "description": "The fields every layer carries. source, verified, approximate and locked are absent on a brand's own rules.",
      "type": "object",
      "required": ["id", "type", "settings"],
      "properties": {
        "id": { "type": "string", "pattern": "^[\\w-]{1,64}$" },
        "type": { "type": "string" },
        "preset": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 200 },
        "visible": { "type": "boolean", "default": true },
        "source": { "enum": ["platform", "technology", "directory", "measured"], "description": "Who set the rule." },
        "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The date the rule was last checked." },
        "approximate": { "type": "boolean", "description": "A measured estimate. Drawn differently, so it never claims more precision than it has." },
        "locked": { "type": "boolean", "description": "A platform rule no brand edits." },
        "settings": { "type": "object" }
      }
    },
    "layer": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "id": true, "type": true, "preset": true, "label": true, "visible": true,
            "source": true, "verified": true, "approximate": true, "locked": true, "settings": true
          },
          "additionalProperties": false
        },
        {
          "oneOf": [
            { "properties": { "type": { "const": "specimen" }, "settings": { "$ref": "#/$defs/specimenSettings" } } },
            { "properties": { "type": { "const": "zone" }, "settings": { "$ref": "#/$defs/zoneSettings" } } },
            { "properties": { "type": { "const": "shape" }, "settings": { "$ref": "#/$defs/shapeSettings" } } },
            { "properties": { "type": { "const": "guide" }, "settings": { "$ref": "#/$defs/guideSettings" } } },
            { "properties": { "type": { "const": "grid" }, "settings": { "$ref": "#/$defs/gridSettings" } } },
            { "properties": { "type": { "const": "measure" }, "settings": { "$ref": "#/$defs/measureSettings" } } },
            { "properties": { "type": { "const": "note" }, "settings": { "$ref": "#/$defs/noteSettings" } } },
            { "properties": { "type": { "const": "image" }, "settings": { "$ref": "#/$defs/imageSettings" } } }
          ]
        }
      ]
    },
    "group": {
      "description": "One switch for a set of layers. One level deep, and never holding the specimen.",
      "type": "object",
      "required": ["id", "type", "layers"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[\\w-]{1,64}$" },
        "type": { "const": "group" },
        "label": { "type": "string", "maxLength": 200 },
        "visible": { "type": "boolean", "default": true },
        "crop": {
          "description": "What one place shows of the file, in the canvas's own px. While the group shows, everything outside it is masked in the ground's colour.",
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "additionalProperties": false,
          "properties": {
            "form": { "enum": ["rect", "circle"], "default": "rect" },
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "w": { "type": "number", "exclusiveMinimum": 0 },
            "h": { "type": "number", "exclusiveMinimum": 0 },
            "r": {
              "description": "A rectangle's corner radii, top left first and clockwise, in reference px.",
              "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0 }
            }
          }
        },
        "view": {
          "description": "Groups sharing a view name are views of the same file: turning one on turns the others off.",
          "type": "string", "pattern": "^[\\w-]{1,64}$"
        },
        "disables": {
          "description": "Switches this group turns off while it shows; their own visible is kept.",
          "type": "array", "items": { "type": "string", "pattern": "^[\\w-]{1,64}$" }
        },
        "layers": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/layer" },
              { "not": { "properties": { "type": { "const": "specimen" } }, "required": ["type"] } }
            ]
          }
        }
      }
    },
    "specimenSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "$ref": "#/$defs/length", "description": "In %, a share of the fit; in px, the specimen's width." },
        "offsetX": { "$ref": "#/$defs/length" },
        "offsetY": { "$ref": "#/$defs/length" },
        "overshootTop": { "$ref": "#/$defs/length" },
        "overshootRight": { "$ref": "#/$defs/length" },
        "overshootBottom": { "$ref": "#/$defs/length" },
        "overshootLeft": { "$ref": "#/$defs/length" },
        "opacity": { "$ref": "#/$defs/fraction" }
      }
    },
    "zoneSettings": {
      "description": "Derived: a box, an edge and an amount. It follows the box.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": { "enum": ["ring", "area"], "default": "ring" },
        "edge": { "enum": ["inside", "outside"], "default": "inside" },
        "reference": { "$ref": "#/$defs/reference" },
        "amount": { "$ref": "#/$defs/length" },
        "draw": { "$ref": "#/$defs/draw" },
        "lineWeight": { "$ref": "#/$defs/lineWeight" },
        "lineStyle": { "$ref": "#/$defs/lineStyle" },
        "outlineColour": { "$ref": "#/$defs/colour", "description": "The outline's colour: every line the layer draws." },
        "outlineOpacity": { "$ref": "#/$defs/fraction" },
        "fillColour": { "$ref": "#/$defs/colour", "description": "The fill's colour: every area the layer draws." },
        "fillOpacity": { "$ref": "#/$defs/fraction" },
        "marker": { "enum": ["none", "glyph", "text", "svg", "image"] },
        "markerText": { "type": "string", "maxLength": 12 },
        "markerSrc": { "type": "string" },
        "markerRotate": { "type": "number" },
        "markerOrient": { "enum": ["follow", "fixed"] },
        "markerRepeat": { "enum": ["edges", "tile"] },
        "markerColour": { "$ref": "#/$defs/colour" },
        "markerOpacity": { "$ref": "#/$defs/fraction" }
      }
    },
    "shapeSettings": {
      "description": "Placed: its own position and size. It follows nothing.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form": { "enum": ["rectangle", "circle", "rounded"], "default": "rectangle" },
        "radius": { "type": "number", "minimum": 0, "maximum": 50 },
        "x": { "$ref": "#/$defs/length" },
        "y": { "$ref": "#/$defs/length" },
        "w": { "$ref": "#/$defs/length" },
        "h": { "$ref": "#/$defs/length" },
        "draw": { "enum": ["outline", "fill", "both", "outside"], "description": "outside: the shape outlined and everything beyond it, out to the canvas edge, shaded in the fill. A safe area drawn the way the Figma templates draw it." },
        "lineWeight": { "$ref": "#/$defs/lineWeight" },
        "lineStyle": { "$ref": "#/$defs/lineStyle" },
        "outlineColour": { "$ref": "#/$defs/colour", "description": "The outline's colour: every line the layer draws." },
        "outlineOpacity": { "$ref": "#/$defs/fraction" },
        "fillColour": { "$ref": "#/$defs/colour", "description": "The fill's colour: every area the layer draws." },
        "fillOpacity": { "$ref": "#/$defs/fraction" }
      }
    },
    "guideSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["centre", "diagonal", "circle", "square", "thirds", "line"], "default": "centre" },
        "axis": { "enum": ["vertical", "horizontal"] },
        "reference": { "$ref": "#/$defs/reference" },
        "bleed": { "type": "boolean", "description": "Straight lines run out to the bleed: the canvas, zones and shapes, never the specimen." },
        "position": { "$ref": "#/$defs/length" },
        "size": { "$ref": "#/$defs/length" },
        "ratio": { "type": "number", "minimum": 1, "maximum": 1000 },
        "radius": { "type": "number", "minimum": 0, "maximum": 50 },
        "draw": { "$ref": "#/$defs/draw" },
        "lineWeight": { "$ref": "#/$defs/lineWeight" },
        "lineStyle": { "$ref": "#/$defs/lineStyle" },
        "outlineColour": { "$ref": "#/$defs/colour", "description": "The outline's colour: every line the layer draws." },
        "outlineOpacity": { "$ref": "#/$defs/fraction" },
        "fillColour": { "$ref": "#/$defs/colour", "description": "The fill's colour: every area the layer draws." },
        "fillOpacity": { "$ref": "#/$defs/fraction" }
      }
    },
    "gridSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["cells", "columns", "rows"], "default": "cells" },
        "reference": { "$ref": "#/$defs/reference" },
        "cell": { "$ref": "#/$defs/length" },
        "align": { "enum": ["start", "centre"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "margin": { "$ref": "#/$defs/length" },
        "gutter": { "$ref": "#/$defs/length" },
        "draw": { "$ref": "#/$defs/draw" },
        "lineWeight": { "$ref": "#/$defs/lineWeight" },
        "lineStyle": { "$ref": "#/$defs/lineStyle" },
        "outlineColour": { "$ref": "#/$defs/colour", "description": "The outline's colour: every line the layer draws." },
        "outlineOpacity": { "$ref": "#/$defs/fraction" },
        "fillColour": { "$ref": "#/$defs/colour", "description": "The fill's colour: every area the layer draws." },
        "fillOpacity": { "$ref": "#/$defs/fraction" }
      }
    },
    "measureSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["canvas", "specimen", "zone-inset", "zone-area", "all", "span"], "default": "canvas", "description": "What is measured: a box (the canvas, the specimen, the canvas and its bleed), a zone's inset, the area inside a zone, or a span: from one point to another along the axis, at a position across it." },
        "zone": { "type": "string", "description": "The id of the zone measured, when the target is zone-inset or zone-area." },
        "from": { "$ref": "#/$defs/length", "description": "A span's start along the axis, from the canvas's left or top." },
        "to": { "$ref": "#/$defs/length", "description": "A span's end along the axis." },
        "at": { "$ref": "#/$defs/length", "description": "Where a span's line sits across the axis: from the top for a width, from the left for a height." },
        "axis": { "enum": ["width", "height"], "default": "width", "description": "One line per measure: the width, drawn horizontally, or the height, drawn vertically." },
        "edge": { "enum": ["start", "centre", "end"], "default": "end", "description": "Where the line sits across the box: for a width, start is the top and end the bottom; for a height, start is the left and end the right." },
        "value": { "enum": ["on-line", "left", "right", "top", "bottom"], "default": "bottom", "description": "Where the number sits: on the line, or beside it." },
        "size": { "enum": ["default", "large"], "default": "default", "description": "Large doubles the lines, the ticks and the value." },
        "valueStyle": { "enum": ["filled", "text"], "default": "filled", "description": "Filled is a pill in the measure's colour; text is the number in that colour." },
        "lineWeight": { "$ref": "#/$defs/lineWeight" },
        "lineStyle": { "$ref": "#/$defs/lineStyle" },
        "colour": { "$ref": "#/$defs/colour" },
        "opacity": { "$ref": "#/$defs/fraction" }
      }
    },
    "noteSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "maxLength": 120 },
        "colour": { "$ref": "#/$defs/colour", "description": "Empty is text on the ground's paper; a colour makes the note a pill in it." },
        "x": { "$ref": "#/$defs/length" },
        "y": { "$ref": "#/$defs/length" },
        "anchor": { "enum": ["centre", "start"], "default": "centre", "description": "centre: the point is the note's middle. start: the point is its top-left corner, so a note sits inside a corner." }
      }
    },
    "imageSettings": {
      "description": "Under the specimen, a reference; over it, a rule such as a platform's interface.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string" },
        "x": { "$ref": "#/$defs/length" },
        "y": { "$ref": "#/$defs/length" },
        "w": { "$ref": "#/$defs/length" },
        "h": { "$ref": "#/$defs/length" },
        "fit": { "enum": ["contain", "cover"] },
        "opacity": { "$ref": "#/$defs/fraction" }
      }
    }
  }
}
